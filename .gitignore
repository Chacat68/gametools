!test/test_output/.gitkeep

# 测试在 test/_runtime/ 下生成的文件（勿提交；含 generated/ 下 create_test_data 输出）
test/_runtime/

# 遗留：早期在仓库根或 test/ 下直接生成的目录（可删；保留规则防误提交）
/test_data/
/test_excel_files/
/test_table_range/
test/test_excel_files/field_extraction_result.*
test/test_table_range/translation_master_*.xlsx

# 遗留：早期脚本曾在仓库根目录生成的目录（可手动删除；保留 ignore 防误提交）
/test_config_sync/
/test_multi_lang/
/test_output/

